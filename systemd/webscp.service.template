[Unit]
Description=webscp two-pane SCP/SFTP web UI
After=network.target

[Service]
Type=simple
# Replace __APP_DIR__ and __USER__ on install (see scripts/install-systemd.sh).
WorkingDirectory=__APP_DIR__
ExecStart=/usr/bin/env node __ENTRY_POINT__
Restart=on-failure
RestartSec=3
User=__USER__
Environment=WEBSCP_HOST=127.0.0.1
Environment=WEBSCP_PORT=8088
# Preserve HTTP config overrides and the installer's resolved group directory.
__CONFIG_ENV__

[Install]
WantedBy=multi-user.target
